# ─────────────────────────────────────────────────────────────
#  Uzhavan API — environment
#  Copy to .env and fill in. NEVER commit .env.
#  Generate every secret below with:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────

# --- Database -------------------------------------------------
# `connection_limit` matters if the Postgres instance is shared with other
# apps. Prisma otherwise opens (CPU cores × 2 + 1) connections per process,
# which on a dev machine is ~20 — enough to crowd out other tenants on a
# server with the default max_connections of 100. Five is ample for this API;
# raise it only if you see pool timeouts under real load.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&connection_limit=5&pool_timeout=20&connect_timeout=10

# --- Server ---------------------------------------------------
PORT=4000
NODE_ENV=development
# Allowed CORS origin(s). "*" for any, or a comma-separated list.
# Set this to your admin console origin in production — do not ship "*".
CORS_ORIGIN=*

# --- Password hashing ----------------------------------------
# bcrypt cost factor. 12 ≈ 250ms per hash on modern hardware.
# Raising this is safe: existing hashes keep working and are
# transparently re-hashed at the user's next successful login.
BCRYPT_ROUNDS=12

# Server-side secret mixed into every password before bcrypt
# (HMAC-SHA256). A stolen database is useless without it, because
# the pepper lives here and never in the database.
# 32 bytes hex. Treat like a private key.
PASSWORD_PEPPER=

# Bump when you rotate PASSWORD_PEPPER. Old hashes record the
# version they were made with, so both can be verified during a
# rollover. See docs/SECURITY.md before changing.
PASSWORD_PEPPER_VERSION=1

# --- Field & document encryption ------------------------------
# AES-256-GCM key protecting GSTIN / Udyam / farmer-card numbers
# and every uploaded KYC document. 32 bytes hex.
# Losing this makes that data permanently unreadable — back it up
# somewhere other than the database server.
ENCRYPTION_KEY=

# --- Sessions -------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Uploads --------------------------------------------------
# Max size of a single KYC document, in megabytes.
MAX_UPLOAD_MB=5

# --- Support desk ---------------------------------------------
# Fallbacks only. Once the admin console is live these are
# editable at runtime and the database value wins.
SUPPORT_EMAIL=support@uzhavan.app
SUPPORT_PHONE=+91 80000 00000

# Hours an unassigned or untouched ticket may sit before it is
# force-assigned to the least-loaded staff member.
TICKET_ESCALATION_HOURS=24

# --- Getting messages to people --------------------------------
# Both default to "log", which prints the message to the server
# console instead of sending it. That means password reset works
# on a laptop with no accounts anywhere — and a missing
# credential shows up as a visible log line rather than a message
# that silently never arrives.
#
# In production the server refuses to boot with both on "log",
# because a locked-out farmer would have no way back in.

# log | smtp
EMAIL_DRIVER=log
# Any SMTP URL, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=Uzhavan <no-reply@uzhavan.app>

# log | msg91
SMS_DRIVER=log
MSG91_AUTH_KEY=
# The six-character sender id registered with your DLT template.
MSG91_SENDER_ID=UZHAVN

# How long a password reset code stays valid. Short on purpose:
# six digits is only safe because guessing is tightly bounded.
RESET_CODE_MINUTES=15
