{
  "expo": {
    "name": "Uzhavan",
    "slug": "uzhavan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.uzhavan.buyer"
    },
    "android": {
      "package": "com.uzhavan.buyer",
      "adaptiveIcon": {
        "backgroundColor": "#1B5E3B"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6F0"
        }
      ],
      "expo-secure-store"
    ]
  }
}
